# logger-crab local/dev env vars. Copy to `.env` and fill in.

# HTTP
PORT=8080

# Hot tier
DATABASE_URL=sqlite://./var/logs.db
HOT_STORE=memory          # memory | sqlite

# Cold tier
COLD_STORE=noop           # noop | s3
S3_LOGS_BUCKET=versable-logs
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# Auth — `openssl rand -hex 32` for each
INGEST_TOKEN=
DASHBOARD_TOKEN=

# Alerting (V1.5)
ENABLE_ALERTS=false
SLACK_WEBHOOK_URL=

# Logging
RUST_LOG=info,log_server=debug
